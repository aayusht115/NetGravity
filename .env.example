# NetGravity — Environment Configuration
# =======================================
# Copy to .env and fill in. .env is gitignored; never commit real credentials.
#
#     cp .env.example .env
#
# EVERY variable here is optional. With none of them set, the ingestion
# pipeline runs against local disk in AI stub mode — which is exactly how it
# should behave on a fresh clone.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# PLACEHOLDER — leave blank until the team confirms provider and key.
#
# Blank  => STUB MODE: canned responses, no network calls, tests still pass,
#           and every stubbed result is labelled as such in the report.
# Set    => LIVE MODE: real extraction, no other change required.
# THE SWITCHES
# ------------
# Leave both false (or delete the lines) to use OpenAI / ChatGPT — the default.
# Set exactly one to true. NETGRAVITY_USE_GATEWAY is checked first.
NETGRAVITY_USE_CLAUDE=false

# The Text Generation Gateway: an internal endpoint wrapping a fixed model.
# It is NOT OpenAI-compatible — it has its own address and token below, and
# its own code path. Set true to use it.
NETGRAVITY_USE_GATEWAY=false

# KEYS
# ----
# Easiest setup: put BOTH keys here. Then flipping the switch above is the
# only edit you ever make — an OpenAI key does not work at Anthropic, so a
# single shared key would have to be swapped by hand on every switch.
NETGRAVITY_OPENAI_API_KEY=
NETGRAVITY_ANTHROPIC_API_KEY=

# Generic fallback, used when the provider-specific one above is blank.
# Fine if you only ever use one vendor.
NETGRAVITY_LLM_API_KEY=


# ---------------------------------------------------------------------------
# Text Generation Gateway  (only when NETGRAVITY_USE_GATEWAY=true)
# ---------------------------------------------------------------------------
# Base address, no trailing path — the code appends /v1/generate itself.
NETGRAVITY_GATEWAY_URL=

# The gateway-issued bearer token. This is NOT an OpenAI or Anthropic key,
# which is why it has its own variable: it must never be picked up as one.
#
# Treat it as a shared secret. The budget and rate limits behind it are
# SHARED by everyone holding the same token, and the cost budget is
# CUMULATIVE — it does not reset daily. Server-side only; never put it in
# browser or mobile code, a URL, a log, or a commit.
NETGRAVITY_GATEWAY_TOKEN=

# What the gateway fixes and you cannot change from here:
#   model            fixed server-side (gpt-5-mini at time of writing)
#   max output       2,000 tokens
#   max prompt       100,000 characters (larger is refused before sending)
#   JSON mode        not available — asked for in the prompt instead
#   PDF / documents  not supported at all, text prompts only
#
# The gateway's own guide recommends a client timeout slightly above its
# 60s processing timeout, so set this to 90 when using it:
#   NETGRAVITY_LLM_TIMEOUT_SECONDS=90


# Leave blank and the model follows the switch automatically
# (OpenAI -> gpt-4o-mini, Claude -> claude-sonnet-4-5).
# Set it only to pin a specific model. Model names change often, so this
# belongs here rather than in code.
NETGRAVITY_LLM_MODEL=

# Network behaviour for live calls. Use 90 with the gateway (see above).
NETGRAVITY_LLM_TIMEOUT_SECONDS=60
NETGRAVITY_LLM_MAX_RETRIES=3

# false -> a failed API call degrades to stub data, loudly labelled in the report
# true  -> a failed API call fails the run
# Set true for any run whose numbers someone might act on.
NETGRAVITY_LLM_STRICT=false

# Optional: use a free/alternate provider instead of real OpenAI, with no
# other code change. Several providers accept the exact same request format
# OpenAI does ("OpenAI-compatible") — only the server address differs.
# Leave blank to use real OpenAI. To use one of these instead, set this to
# its address, put ITS key in NETGRAVITY_OPENAI_API_KEY above (leave
# NETGRAVITY_USE_CLAUDE=false), and set NETGRAVITY_LLM_MODEL to a model name
# that provider recognises (their model names, not OpenAI's).
#
#   OpenRouter    : https://openrouter.ai/api/v1
#   Groq          : https://api.groq.com/openai/v1
#   Cerebras      : https://api.cerebras.ai/v1
#   GitHub Models : https://models.inference.ai.azure.com
#   Google Gemini : https://generativelanguage.googleapis.com/v1beta/openai/
NETGRAVITY_LLM_BASE_URL=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# local      -> filesystem under NETGRAVITY_DATA_ROOT   (development)
# azure_blob -> Azure Blob Storage containers            (deployment)
#
# The zone/key layout is identical either way, so switching backends is this
# one variable plus a connection string.
NETGRAVITY_STORAGE_BACKEND=local
NETGRAVITY_DATA_ROOT=./data

# Required only when NETGRAVITY_STORAGE_BACKEND=azure_blob.
# On Azure this should be a Key Vault secret reference, not a literal value.
NETGRAVITY_AZURE_CONN_STR=


# ---------------------------------------------------------------------------
# Token accounting (optional)
# ---------------------------------------------------------------------------
# Cost estimates shown at the end of a run come from a small rate table in
# netgravity/telemetry/token_usage.py. A model with no configured rate still
# has its TOKENS counted; only its cost shows as "unknown" — deliberately,
# rather than being guessed at.
#
# Rates change more often than code should, so they are overridable here.
# Format: name:usd_per_1M_input:usd_per_1M_output, comma-separated.
#   NETGRAVITY_TOKEN_PRICES="gemini-2.5-flash:0.10:0.40"
NETGRAVITY_TOKEN_PRICES=

# ---------------------------------------------------------------------------
# Durable storage
# ---------------------------------------------------------------------------
# PostgreSQL is where accounts, projects, uploaded networks, the analysis
# computed from them and solved scenarios are kept. Set this and restart.
#
# Unset => the application falls back to a local SQLite file
#          (NETGRAVITY_DB_PATH, default data/netgravity.db) and reports
#          "engine": "sqlite" on /api/status. SQLite has ONE writer: it is
#          fine for a single process and wrong for two.
#
# Migrating an existing SQLite store, once, before switching:
#     python scripts/migrate_to_postgres.py \
#         --sqlite data/netgravity.db --postgres postgresql://...
# It is idempotent, does not modify the SQLite file, and verifies every
# document byte-for-byte after copying.
#
# NETGRAVITY_DATABASE_URL=postgresql://user:password@host:5432/netgravity
# DATABASE_URL is also read, for platforms that set it for you.
# NETGRAVITY_DB_POOL_MAX=10
# NETGRAVITY_DB_PATH=data/netgravity.db

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# NETGRAVITY_ENV=production turns on Secure cookies, HSTS, same-origin CORS,
# refusal of an unencrypted database connection to a remote host, and refusal
# of the development-only password-reset channel. See docs/operations.md.
#
# NETGRAVITY_ENV=production

# The base URL reset links are built from. WITHOUT this, the link is built from
# the request's Host header, which an attacker can set — turning "reset your
# password" into "send me your reset token". Set it in production.
# NETGRAVITY_PUBLIC_URL=https://netgravity.example.com

# How a password-reset link is delivered: log | webhook | smtp.
# 'log' writes it to the application log and is REFUSED in production.
# NETGRAVITY_RESET_DELIVERY=smtp
# NETGRAVITY_RESET_WEBHOOK=https://hooks.example.com/netgravity
# NETGRAVITY_RESET_WEBHOOK_TOKEN=
# NETGRAVITY_SMTP_HOST=smtp.example.com
# NETGRAVITY_SMTP_PORT=587
# NETGRAVITY_SMTP_USER=
# NETGRAVITY_SMTP_PASSWORD=
# NETGRAVITY_SMTP_FROM=no-reply@example.com
# NETGRAVITY_SMTP_STARTTLS=1

# Honour X-Forwarded-For when identifying a client for rate limiting. Set this
# ONLY behind a proxy you control that overwrites the header — otherwise any
# caller sets their own identity and the rate limit stops existing.
# NETGRAVITY_TRUSTED_PROXY=1

# Rate limiting is on by default. This switch exists for load testing.
# NETGRAVITY_DISABLE_RATE_LIMIT=1

# LLM call budget. Per execution, plus a cumulative cap for the process.
# NETGRAVITY_LLM_MAX_REQUESTS_PER_EXECUTION=4
# NETGRAVITY_LLM_MAX_REQUESTS_TOTAL=500

# ---------------------------------------------------------------------------
# Rate limits — per bucket, per client, shared across every worker
# ---------------------------------------------------------------------------
# Counters live in the database now, so the number written here is the number
# actually enforced. It used to be per process, which meant N workers gave one
# caller N budgets. Raise a limit for a deployment whose legitimate traffic
# needs it; auth.signup defaults to 60/hour because a team behind one office
# NAT was capped at 10.
# NETGRAVITY_RATELIMIT_AUTH_LOGIN=20
# NETGRAVITY_RATELIMIT_AUTH_SIGNUP=60
# NETGRAVITY_RATELIMIT_AUTH_RESET=10
# NETGRAVITY_RATELIMIT_KPI_READ=240
# NETGRAVITY_RATELIMIT_INSIGHTS_READ=120
# NETGRAVITY_RATELIMIT_SCENARIO_SIMULATE=30

# ---------------------------------------------------------------------------
# Single sign-on (OpenID Connect)
# ---------------------------------------------------------------------------
# Off unless ISSUER, CLIENT_ID and REDIRECT_URI are all set. The sign-in screen
# shows a button only when /api/auth/oidc/providers says one can work.
# NETGRAVITY_OIDC_ISSUER=https://login.example.com
# NETGRAVITY_OIDC_CLIENT_ID=
# NETGRAVITY_OIDC_CLIENT_SECRET=            # omit for a public client; PKCE is always on
# NETGRAVITY_OIDC_REDIRECT_URI=https://app.example.com/api/auth/oidc/callback
# NETGRAVITY_OIDC_SCOPES=openid email profile
# NETGRAVITY_OIDC_PROVIDER_NAME=Company SSO

# Only these e-mail domains may sign in. Applied to the address the provider
# asserts, and only when the provider says it is VERIFIED.
# NETGRAVITY_OIDC_ALLOWED_DOMAINS=example.com,example.org

# Create a NetGravity account on a first successful sign-in. OFF by default: a
# configured provider usually authenticates a whole directory, and being
# authenticated is not the same as being invited.
# NETGRAVITY_OIDC_AUTO_PROVISION=1

# ---------------------------------------------------------------------------
# Point-in-time recovery tooling (scripts/pitr.py)
# ---------------------------------------------------------------------------
# Where pg_basebackup / pg_ctl live, when they are not on PATH.
# NETGRAVITY_PG_BINDIR=/usr/lib/postgresql/16/bin
# Port the recovery DRILL starts its scratch cluster on. Never the live port.
# NETGRAVITY_PITR_DRILL_PORT=55433
# ---------------------------------------------------------------------------
# Action Agent — outbound email
# ---------------------------------------------------------------------------
# PLACEHOLDER — no outbound email credential exists yet, and none should be
# requested without explicit sign-off. Same rule as the LLM section above:
#
# Blank  => STUB MODE: no email is actually sent. Every send is logged
#           ("would have emailed ...") and recorded in the dispatch log,
#           so the whole Action Agent and its test suite run end to end
#           with no network calls and no credentials.
# Set    => LIVE MODE via SMTP, no other code change required.
NETGRAVITY_SMTP_HOST=
NETGRAVITY_EMAIL_API_KEY=

# Only read once NETGRAVITY_SMTP_HOST above is set.
#   Gmail            smtp.gmail.com, port 587, TLS — username is the full
#                     address, password must be an APP PASSWORD
#                     (myaccount.google.com/apppasswords), not the normal
#                     account password (Gmail requires 2FA for this).
#   Google Workspace  same as Gmail.
#   Microsoft 365     smtp.office365.com, port 587, TLS.
#   A local catch-all (e.g. Mailtrap/Ethereal sandbox, for testing without
#   risking a real inbox) — use the host/port/credentials it gives you.
NETGRAVITY_SMTP_PORT=587
NETGRAVITY_SMTP_USERNAME=
NETGRAVITY_SMTP_PASSWORD=
# "false" only for a local relay with no TLS at all. Real providers need true.
NETGRAVITY_SMTP_USE_TLS=true
# From: header. Blank => falls back to NETGRAVITY_SMTP_USERNAME.
NETGRAVITY_SMTP_FROM_ADDRESS=

# "true" => a failed live send raises instead of degrading to a labelled
# stub result. Mirrors NETGRAVITY_LLM_STRICT. Default false.
NETGRAVITY_EMAIL_STRICT=false

# ---------------------------------------------------------------------------
# Action Agent — inbound email (reply-by-email upload)
# ---------------------------------------------------------------------------
# INFRASTRUCTURE PREREQUISITE, outside this codebase: a domain (or
# subdomain) configured with an inbound-email provider (SendGrid Inbound
# Parse is what netgravity/action_agent/inbound_email.py parses), a DNS MX
# record pointed at that provider, and the provider's webhook pointed at
# POST /api/inbound-email. This is a DNS/domain setup step, not something
# that can be configured from this file alone.
#
# Blank is safe: missing-data emails simply omit the Reply-To header, and
# the resume link still works.
NETGRAVITY_INBOUND_EMAIL_DOMAIN=

# ---------------------------------------------------------------------------
# Action Agent — default recipients (dev/test seed only)
# ---------------------------------------------------------------------------
# Used ONCE to populate the notification-recipients store if it is empty.
# Fully editable afterward through the recipients store/UI — not permanent,
# and not a substitute for real distributor contacts.
NETGRAVITY_DEFAULT_RECIPIENT_EMAIL=
NETGRAVITY_DEFAULT_TEST_RECIPIENT_EMAIL=

# Base URL used to build resume/deep links in emails (e.g.
# https://app.netgravity.example). Blank => a relative path is used
# instead — honest about the fact that the frontend has no router to
# receive it yet. MUST be set to something absolute (e.g.
# http://localhost:5050 while running `python app/backend/app.py` locally)
# for a link to actually be clickable from an email client — a relative
# path has no "current site" to resolve against there. Landing pages for
# these links today are the placeholders in
# netgravity/action_agent/deep_link_placeholder.py — swap this for the
# frontend's real origin once it owns those routes.
NETGRAVITY_APP_BASE_URL=
