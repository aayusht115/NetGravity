# NetGravity data zones (Phase 4A — ingestion)
# Raw client files and generated snapshots must never be committed.
# .gitkeep files preserve the folder structure; contents are ignored.
data/raw/*
!data/raw/.gitkeep
data/standardized/*
!data/standardized/.gitkeep
data/curated/*
!data/curated/.gitkeep

# Sample / demo datasets are NOT committed.
# data/mock/india/ is fabricated demo data used to exercise the pipeline.
# It must be shared separately or regenerated before running:
#     python -m netgravity.ingestion --source data/mock/india
data/mock/

# Local transfer scratch — not part of the project
_to_delete/

# Validation-harness RAW per-seed dumps. Regenerable in minutes by running
# `forecasting_validation/run_validation.py` or
# `run_structural_break_validation.py`, and 74k lines of intermediate records
# between them. The SUMMARIES, censuses, benchmarks, plots and reports beside
# them ARE tracked — those are the evidence the docs cite; these are the
# working data the summaries were computed from.
forecasting_validation/**/*_raw.json

# Durable application state (accounts, projects, uploaded networks, scenarios).
# Customer data — never committed. `NETGRAVITY_DB_PATH` selects the location.
data/netgravity.db
data/netgravity.db-wal
data/netgravity.db-shm
*.db
*.db-wal
*.db-shm

# Verified database dumps produced by scripts/backup_database.py
backups/
*.dump
validation/**/backup_check/
